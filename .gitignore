# LaTeX build artifacts
*.aux
*.log
*.out
*.synctex.gz
*.fls
*.fdb_latexmk
*.toc

# Your private applications — keep your own job applications OUT of git.
# (Remove this line if you actually want to version your applications.)
applications/*
!applications/.gitkeep
!applications/EXAMPLE/

# Your real master resume holds personal data, and it is yours alone.
# The tracked template is master-resume.example.tex; copy it once to
# master-resume.tex and fill it in. Keeping your copy out of git means
# template updates can never conflict with your own content.
# The compiled PDF holds the same personal data, so it stays out too.
master-resume.tex
master-resume.pdf

# OS / editor junk
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Local Claude Code settings (machine-specific)
.claude/settings.local.json
